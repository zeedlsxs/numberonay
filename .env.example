# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database — Neon PostgreSQL (pooler + direct)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/dbname?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# Auth
JWT_SECRET="uzun-rastgele-bir-gizli-anahtar"

# SMS Provider
SMS_PROVIDER_MODE=mock

# Payments
PAYMENTS_ENABLED=true
IYZICO_API_KEY=sandbox-api-key
IYZICO_SECRET_KEY=sandbox-secret-key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Security
RATE_LIMIT_MAX_REQUESTS=5
RATE_LIMIT_WINDOW_MS=60000

NODE_ENV=development
